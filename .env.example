# Copy this file to .env and fill in the values.
# All variables are read by app/core/config.py (names are case-sensitive).
# Every variable has a default there, so the app boots with none of these set —
# but the ones marked REQUIRED below must be set for a real deployment.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SocialPilot
DEBUG=false

# REQUIRED in production: JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-secrets
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Default is a local SQLite file. For Postgres use e.g.:
#   postgresql://user:password@host:5432/socialpilot
DATABASE_URL=sqlite:///./socialpilot.db

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# REQUIRED for all AI features (captions, agent, campaigns, brand voice,
# post intelligence). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Social platform OAuth credentials ─────────────────────────────────────────
# Each platform is optional; connecting/publishing to a platform only works
# if its credentials are set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Welcome emails are skipped entirely if SMTP_HOST is unset.
# Port 587 uses STARTTLS; port 465 uses implicit SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if unset:
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SocialPilot

# Public URL of the frontend, used in email links.
FRONTEND_URL=https://socialpilotapp.xyz

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Redis (queue/cache, optional) ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
